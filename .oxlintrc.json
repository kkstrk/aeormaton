{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "env": {
        "builtin": true
    },
    "categories": {
        "correctness": "error",
        "suspicious": "error",
        "pedantic": "error"
    },
    "rules": {
        "max-lines-per-function": "off",
        "no-async-endpoint-handlers": "off",
    },
    "ignorePatterns": ["dist/*"]
}
